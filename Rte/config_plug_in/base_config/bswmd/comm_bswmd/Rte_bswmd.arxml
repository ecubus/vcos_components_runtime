                            <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:c84880fe-07b8-db3a-e6d2-1b99f205b5a5">
                              <SHORT-NAME>CONDITIONAL</SHORT-NAME>
                              <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
