                        <ECUC-INTEGER-PARAM-DEF UUID="ECUC:83b0c418-daae-4fa6-b9c9-f1278b727989">
                          <SHORT-NAME>RteTriggerSourceQueueLength</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Length of trigger queue on the trigger source side.</L-2>
                          </DESC>
