                                <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                              </ECUC-ENUMERATION-LITERAL-DEF>
                              <ECUC-ENUMERATION-LITERAL-DEF UUID="ECUC:b85b3d32-4206-90c4-365c-2bde3dea8e96">
                                <SHORT-NAME>RTE_RIPS_IGNORE_MODE_DISABLINGS</SHORT-NAME>
