                            </ECUC-VALUE-CONFIGURATION-CLASS>
                          </VALUE-CONFIG-CLASSES>
                          <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/Rte/RteOsInteraction/RteSyncPoint</DESTINATION-REF>
                        </ECUC-REFERENCE-DEF>
